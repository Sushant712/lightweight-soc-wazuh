<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="windows,authentication_failed,">
  
  <rule id="100301"
        level="12"
        frequency="5"
        timeframe="180"
        ignore="180">
      
     <if_matched_sid>60122</if_matched_sid>
     <same_field>win.eventdata.targetUserName</same_field>
      
     <description>
       Five failed login attempts detected for user $(win.eventdata.targetUserName)</description>
        
     <mitre>
       <id>T1110.001</id>
     </mitre>
   </rule>
</group>

<group name="windows,account_creation,">
 
  <rule id= "100302" level="10">
    <if_sid>60109</if_sid>
    <field name="win.system.eventID">^4720$</field>
    <time>6 pm - 8 am</time>

    <description>
      Account $(win.eventdata.targetUserName) created outside normal hours.
    </description>

    <mitre>
      <id>T1136.001</id>
    </mitre>
   </rule>

</group>

<group name="windows,privileged_account,">
 
  <rule id="100303" level="12">
    <decoded_as>windows_eventchannel</decoded_as>
    <field name="win.system.eventID">^4732$</field>
    <field name="win.eventdata.targetUserName"
           type="pcre2">(?i)^Administrators$</field>

    <description>
      Account $(win.eventdata.memberName) was added to the local administrators group by $(win.eventdata.subjectUserName).
    </description>

    <mitre>
      <id>T1098.007</id>
    </mitre>
   </rule>

</group>
